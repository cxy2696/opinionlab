# OpinionLab local development environment.
# Copy to .env (make setup does this automatically) and change secrets before
# exposing the service outside your machine. Never commit the real .env.

OPINIONLAB_ENV=dev
DEPLOYMENT_MODE=saas
REGION=cn
LOG_LEVEL=INFO

# Local services started by docker-compose.yml.
# Keep POSTGRES_PASSWORD and the password in DATABASE_URL in sync.
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://app:CHANGE_ME@127.0.0.1:5432/opinionlab
REDIS_URL=redis://127.0.0.1:6379/0
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Replace with a long random value in any shared environment.
JWT_SECRET=dev-secret-change-me-please-32-bytes

# API protections.
RATE_LIMIT_GLOBAL_RPS=100
RATE_LIMIT_IP_RPS=20
RATE_LIMIT_USER_RPS=30
RATE_LIMIT_ORG_RPS=200
CONNECTOR_ALLOWED_HOSTS=

# Public demo caps.
DEMO_MAX_NODES=400
DEMO_MAX_STEPS=200
DEMO_MAX_REPEATS=20
DEMO_MIN_STEPS=10
DEMO_MIN_REPEATS=1

# Optional local narration; disabled by default.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=45

# Election template review.
USE_CASE_REVIEW_ENABLED=true
